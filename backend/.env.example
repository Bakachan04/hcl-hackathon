# Copy this file to backend/.env and fill in real values. Never commit .env.

# LLM switch: gemini | ollama | mock
LLM_PROVIDER=mock
LLM_MODEL=gemini-3.5-flash-lite
# true = never call a real LLM (template text only); useful without a key
MOCK_LLM=true
GEMINI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Planning
PLAN_START=2026-10-12 06:00
SOLVER_TIME_LIMIT_S=10

# Storage
DB_PATH=../data/planner.db
DATA_DIR=../data/raw
